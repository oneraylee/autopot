{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:phase7:unit": "vitest run __tests__/features/settings/gateway.test.tsx",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "test:phase7:e2e": "playwright test tests/e2e/knowledge-workflow.spec.ts tests/e2e/knowledge-review.spec.ts tests/e2e/gateway-view.spec.ts",
    "test:phase7:e2e:noreport": "playwright test --reporter=line tests/e2e/knowledge-workflow.spec.ts tests/e2e/knowledge-review.spec.ts tests/e2e/gateway-view.spec.ts",
    "verify:phase7": "pnpm lint && pnpm typecheck && pnpm test:phase7:unit && pnpm test:phase7:e2e",
    "verify:phase7:noreport": "pnpm lint && pnpm typecheck && pnpm test:phase7:unit && pnpm test:phase7:e2e:noreport"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.90.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.71.2",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-sanitize": "^6.0.0",
    "shadcn": "^4.0.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@shadcn/ui": "^0.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "jsdom": "^28.1.0",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
